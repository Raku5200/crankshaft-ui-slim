[Unit]
Description=Crankshaft Slim UI Display Setup
Documentation=https://github.com/opencardev/crankshaft-ui-slim
DefaultDependencies=no
# systemd-udev-settle waits for *every* pending udev event and is deprecated;
# on a Pi Zero 2 W it can add several seconds to boot. The setup script now
# polls the DRM connectors itself with a short bounded timeout instead.
After=local-fs.target systemd-udevd.service systemd-udev-trigger.service
Before=crankshaft-ui-slim.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/crankshaft/crankshaft-ui-slim-display-setup.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
WantedBy=graphical.target
